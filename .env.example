# ====================================================================
# MapRank Agency — Environment Variables Configuration
# ====================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,https://maprank.netlify.app

# Database Configuration (MySQL)
# Fill these with your MySQL database credentials (local or hosted: TiDB, Railway, Aiven, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maprank_db

# Admin Security / JWT
JWT_SECRET=maprank_secure_jwt_secret_key_2026_super_safe_token!
JWT_EXPIRES_IN=7d

# Default Initial Admin Credentials (Used by database seeder)
DEFAULT_ADMIN_USER=arsalan
DEFAULT_ADMIN_PASSWORD=MapRank2026!
DEFAULT_ADMIN_EMAIL=abbasarsalan462@gmail.com

# Email Notification Configuration (Nodemailer SMTP)
# Notifications for every inquiry will be delivered to: abbasarsalan462@gmail.com
# Use Gmail App Password or SMTP provider (Brevo, Resend, Sendgrid, Mailgun)
NOTIFICATION_EMAIL=abbasarsalan462@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=abbasarsalan462@gmail.com
# Generate an App Password in your Google Account (Security -> 2-Step Verification -> App passwords)
SMTP_PASS=your_gmail_app_password_here
FROM_EMAIL=MapRank Inquiries <abbasarsalan462@gmail.com>
